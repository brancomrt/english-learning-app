  {
    "id": 5,
    "levelId": 2,
    "grammarTopic": "Simple Present - Questions",
    "title": "Perguntas no Presente Simples",
    "explanation": "Use 'Do' para I/you/we/they e 'Does' para he/she/it. Após does, o verbo volta à forma base (sem -s).",
    "formula": "Do/Does + subject + verb (base form)?",
    "sortOrder": 5,
    "iconEmoji": "🤔",
    "examples": [
      {
        "sentence": "Do you like coffee?",
        "translation": "Você gosta de café?",
        "highlight": "Do you",
        "isCorrect": true
      },
      {
        "sentence": "Does she speak English?",
        "translation": "Ela fala inglês?",
        "highlight": "Does she speak",
        "note": "O verbo fica na forma base após 'does'.",
        "isCorrect": true
      },
      {
        "sentence": "Does he speaks French?",
        "translation": "Ele fala francês?",
        "highlight": "speaks",
        "note": "Erro: após 'does', não use -s. O correto é 'Does he speak French?'",
        "isCorrect": false
      }
    ]
  },
