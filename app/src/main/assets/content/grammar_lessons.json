    "grammarTopic": "Simple Present",
    "title": "Presente Simples",
    "explanation": "O Simple Present é usado para hábitos, rotinas e verdades gerais. Com he/she/it, adicione -s ou -es ao verbo. Use 'do/does' para perguntas e negativas.",
    "formula": "Subject + verb (+ s/es for he/she/it)",
    "sortOrder": 4,
    "iconEmoji": "🔄",
    "examples": [
      {
        "sentence": "I work every day.",
        "translation": "Eu trabalho todos os dias.",
