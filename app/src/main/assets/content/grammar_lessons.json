      },
      {
        "sentence": "She isn't at home.",
        "translation": "Ela não está em casa.",
        "highlight": "isn't",
        "note": "isn't = is not",
        "isCorrect": true
      },
      {
        "sentence": "We aren't late.",
        "translation": "Nós não estamos atrasados.",
        "highlight": "aren't",
        "note": "aren't = are not",
        "isCorrect": true
      }
    ]
  },
  {
    "id": 3,
