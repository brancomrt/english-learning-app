        "note": "Sem alteração para I/you/we/they.",
        "isCorrect": true
      },
      {
        "sentence": "She works at a bank.",
        "translation": "Ela trabalha em um banco.",
        "highlight": "works",
        "note": "Adicione -s para he/she/it.",
        "isCorrect": true
      },
      {
        "sentence": "He watches TV at night.",
        "translation": "Ele assiste TV à noite.",
        "highlight": "watches",
        "note": "Verbos terminados em -ch, -sh, -ss, -x, -o recebem -es.",
        "isCorrect": true
      },
      {
        "sentence": "She work hard.",
        "translation": "Ela trabalha duro.",
        "highlight": "work",
