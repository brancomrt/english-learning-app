    "grammarTopic": "To Be - Questions",
    "title": "Perguntas com To Be",
    "explanation": "Para formar perguntas com 'to be', inverta a posição do verbo e do sujeito. O verbo vem primeiro na pergunta.",
    "formula": "Am/Is/Are + subject + complement?",
    "sortOrder": 3,
    "iconEmoji": "❓",
    "examples": [
      {
        "sentence": "Are you ready?",
        "translation": "Você está pronto?",
        "highlight": "Are you",
        "note": "Inversão: 'You are' vira 'Are you'.",
        "isCorrect": true
      },
      {
        "sentence": "Is he your brother?",
        "translation": "Ele é seu irmão?",
        "highlight": "Is he",
        "note": "Inversão: 'He is' vira 'Is he'.",
        "isCorrect": true
      },
      {
        "sentence": "Am I late?",
        "translation": "Eu estou atrasado?",
        "highlight": "Am I",
        "isCorrect": true
      }
    ]
  },
  {
