[
  {
    "id": 1,
    "levelId": 1,
    "grammarTopic": "To Be - Present",
    "title": "Verbo To Be no Presente",
    "explanation": "O verbo 'to be' (ser/estar) é um dos verbos mais importantes do inglês. No presente, ele tem três formas: am (I), is (he/she/it), are (you/we/they). Use 'to be' para descrever estados, identidades e características.",
    "formula": "Subject + am/is/are + complement",
    "sortOrder": 1,
    "iconEmoji": "📝",
    "examples": [
      {
        "sentence": "I am a student.",
        "translation": "Eu sou um estudante.",
        "highlight": "am",
        "note": "Use 'am' apenas com 'I'.",
        "isCorrect": true
      },
      {
        "sentence": "She is happy.",
        "translation": "Ela está feliz.",
        "highlight": "is",
        "note": "Use 'is' com he/she/it.",
        "isCorrect": true
      },
      {
        "sentence": "They are teachers.",
        "translation": "Eles são professores.",
        "highlight": "are",
        "note": "Use 'are' com you/we/they.",
        "isCorrect": true
      },
      {
        "sentence": "He am tired.",
        "translation": "Ele está cansado.",
        "highlight": "am",
        "note": "Erro comum: 'am' só é usado com 'I'. O correto é 'He is tired'.",
        "isCorrect": false
      }
    ]
  },
  {
    "id": 2,
